---
import City from "./City";
import Head from "./Head.astro";
import { getPlaces, pathOf, SITE_NAME, type Entry } from "../lib/places";
import "../styles/global.css";

interface Props {
  entry?: Entry;
}

const { entry } = Astro.props;
const places = await getPlaces();
const projects = places.map((e) => ({
  slug: e.id,
  path: pathOf(e),
  title: e.data.title,
  place: e.data.place,
  coordinates: e.data.coordinates,
  kind: e.data.kind,
  layer: e.data.layer,
  lights: e.data.lights,
  stack: e.data.stack,
  html: e.rendered?.html ?? "",
}));
const description = entry ? `${entry.data.title} — ${entry.data.place}` : `Personal website of ${SITE_NAME}.`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={entry?.data.title} description={description} image={entry?.id} />
    <script is:inline>
      // ?shot hides the interface, for taking the preview images.
      if (new URLSearchParams(location.search).has("shot")) document.documentElement.classList.add("shot");
    </script>
  </head>
  <body class="city-page">
    <City client:only="react" projects={projects} initialPath={entry ? pathOf(entry) : undefined} />

    <header class="masthead">
      <a class="name" href="/">{SITE_NAME}</a>
      <p class="thesis">TODO: texto do Salvador</p>
    </header>

    <nav class="footline" aria-label="Site">
      <span>Lisbon <time id="lisbon-time"></time></span>
      <a href="/list">List</a>
      <button type="button" id="plan-toggle" aria-pressed="false" hidden>Plan</button>
    </nav>

    <p class="legend">
      <span class="key key-green"></span>Green spaces
      <span class="key key-rail"></span>Railway
      <span class="key key-metro"></span>Metro
      <span class="key key-tram"></span>Tram
    </p>

    <p class="attribution">
      <span class="plan-credit">Green spaces and railways: Câmara Municipal de Lisboa · </span>Map data © <a
        href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a
      >
    </p>

    <noscript>
      <div class="fallback">
        <img src="/city.jpg" alt="Lisbon at night, seen from above" />
      </div>
    </noscript>

    <script is:inline>
      (function () {
        var el = document.getElementById("lisbon-time");
        var format = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Lisbon", hour: "2-digit", minute: "2-digit" });
        function tick() {
          el.textContent = format.format(new Date());
        }
        tick();
        setInterval(tick, 15000);
      })();
    </script>
  </body>
</html>
