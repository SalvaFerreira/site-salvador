---
import City from "./City";
import Head from "./Head.astro";
import { CV_IMAGE, CV_PATH, getContact, getHomeTitle, getPerson, getPlaces, getProfile, htmlOf, PORTRAIT, hasCv, pathOf, SITE_NAME, type Entry } from "../lib/places";
import { CATEGORY_COLOR } from "./City";
import "../styles/global.css";

interface Props {
  entry?: Entry;
}

const { entry } = Astro.props;
const places = await getPlaces();
const profile = await getProfile();
const contact = await getContact();
const person = entry ? undefined : await getPerson(Astro.site);
const homeTitle = await getHomeTitle();
const projects = places.map((e) => ({
  slug: e.id,
  path: pathOf(e),
  title: e.data.title,
  summary: e.data.summary,
  label: e.data.label ?? e.data.title,
  group: e.data.group,
  category: e.data.category,
  place: e.data.place,
  role: e.data.role,
  tagline: e.data.tagline,
  spot: e.data.spot,
  period: e.data.period,
  coordinates: e.data.coordinates,
  kind: e.data.kind,
  lights: e.data.lights,
  date: e.data.date?.toISOString(),
  order: e.data.order,
  images: e.data.images,
  stack: e.data.stack,
  links: e.data.links,
  html: htmlOf(e.rendered),
}));
const description = entry ? `${entry.data.title} — ${entry.data.place}` : `${profile.role} in Lisbon. ${profile.headline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={entry?.data.title} fullTitle={entry ? undefined : homeTitle} description={description} image={entry?.id} jsonLd={person} />
    <script is:inline>
      // ?shot hides the interface, for taking the preview images.
      if (new URLSearchParams(location.search).has("shot")) document.documentElement.classList.add("shot");
    </script>
  </head>
  <body class="city-page">
    <City client:only="react" projects={projects} initialPath={entry ? pathOf(entry) : undefined} email={contact.email} linkedin={contact.linkedin} homeTitle={homeTitle} />

    <header class="topbar" id="topbar">
      {
        entry ? (
          <a class="name" href="/">
            <img class="topbar-photo" src={PORTRAIT} alt="" width="30" height="30" />
            {SITE_NAME}
          </a>
        ) : (
          <h1 class="name-heading">
            <a class="name" href="/">
              <img class="topbar-photo" src={PORTRAIT} alt="" width="30" height="30" />
              {SITE_NAME}
            </a>
          </h1>
        )
      }
      {/* The profile in a few seconds: role, one line, strengths and tools. Folds away (script below). */}
      <p class="topbar-role">{profile.role} · Lisbon</p>
      <p class="thesis">{profile.headline}</p>
      <div class="topbar-more" id="topbar-more">
        <ul class="topbar-strengths" aria-label="Strengths">
          {
            profile.strengths.map((s) => (
              <li>
                <strong>{s.title.split(" for ")[0]}</strong> — {s.short}
              </li>
            ))
          }
        </ul>
        <ul class="topbar-skills" aria-label="Main tools">
          {profile.keySkills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
      <button type="button" class="topbar-toggle" id="topbar-toggle" aria-expanded="true" aria-controls="topbar-more">
        Hide details
      </button>
      <nav aria-label="Site">
        {hasCv && <a href={CV_PATH} class="cv-open">CV</a>}
        <a href="/profile">Profile</a>
        <button type="button" id="tour-start" hidden>Tour</button>
        {
          contact.email && (
            <button type="button" class="copy-email" data-email={contact.email.replace(/^mailto:/, "")}>
              Email
            </button>
          )
        }
        {contact.linkedin && <a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
      </nav>
    </header>

    {
      /* A project's own address: its text is in the page itself, for readers that do not
         run JavaScript (AI agents, some crawlers). The city's panel replaces it (see Panel.tsx). */
      entry && (
        <article class="panel" id="ssr-panel" aria-labelledby="ssr-title">
          <div class="panel-bar">
            <a class="panel-close" href="/">Close</a>
          </div>
          <p class="panel-place">
            {entry.data.category && `${{ job: "Work", education: "Education", personal: "Personal project" }[entry.data.category]} · `}
            {entry.data.place}
          </p>
          <h1 id="ssr-title">{entry.data.title}</h1>
          {
            (entry.data.role || entry.data.period) && (
              <p class="panel-role">{[entry.data.role, entry.data.period].filter(Boolean).join(" · ")}</p>
            )
          }
          {entry.data.summary && <p class="panel-summary">{entry.data.summary}</p>}
          {
            entry.data.stack.length > 0 && (
              <ul class="panel-stack" aria-label="Tools">
                {entry.data.stack.map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
            )
          }
          <div class="panel-body" set:html={htmlOf(entry.rendered)} />
          {
            entry.data.links.length > 0 && (
              <p class="panel-links">
                {entry.data.links.map((link) => (
                  <a href={link.url}>{link.label}</a>
                ))}
              </p>
            )
          }
          <p class="panel-links">
            <a href="/profile">Full profile of {SITE_NAME}</a>
          </p>
        </article>
      )
    }

    {/* Shown while the city loads (City.tsx fills in the share and hides it); only with JavaScript. */}
    <p class="loading" id="loading" role="status" hidden>
      Building Lisbon<span class="loading-share" aria-hidden="true"></span>
    </p>
    <script is:inline>
      if (!document.documentElement.classList.contains("shot")) document.getElementById("loading").hidden = false;
    </script>

    <div class="controls">
      <div class="controls-buttons" role="group" aria-label="Map">
        <button type="button" id="zoom-in" aria-label="Zoom in" title="Zoom in" hidden>+</button>
        <button type="button" id="zoom-out" aria-label="Zoom out" title="Zoom out" hidden>−</button>
        <button type="button" id="go-home" aria-label="Show all places" title="Show all places" hidden>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M2 8.2 8 2.8l6 5.4M4 7.2V13h3v-3.2h2V13h3V7.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <span class="clock" id="clock">Lisbon <time id="lisbon-time"></time></span>
    </div>


    <ul class="colour-key" aria-label="Colours of the places">
      <li><span class="place-dot" style={`--dot: ${CATEGORY_COLOR.job}`}></span>Work</li>
      <li><span class="place-dot" style={`--dot: ${CATEGORY_COLOR.education}`}></span>Education</li>
      <li><span class="place-dot" style={`--dot: ${CATEGORY_COLOR.personal}`}></span>Personal projects</li>
    </ul>

    <p class="attribution">
      <span class="attr-long">Green spaces, trees and railways: Câmara Municipal de Lisboa · Elevation: Copernicus DEM (ESA) · Map data</span> © <a
        href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a
      ><span class="attr-short"> · CM Lisboa</span>
    </p>

    <script is:inline>
      // The profile card folds to its first lines: open by default on wide screens, folded on
      // phones and short screens (so all the places still fit on the map), and remembered for the visit.
      (function () {
        var bar = document.getElementById("topbar");
        var button = document.getElementById("topbar-toggle");
        var key = "profile-card";
        var saved = null;
        try {
          saved = sessionStorage.getItem(key);
        } catch (e) {}
        function set(open) {
          bar.classList.toggle("is-folded", !open);
          button.setAttribute("aria-expanded", open ? "true" : "false");
          button.textContent = open ? "Hide details" : "Strengths and tools";
        }
        set(saved ? saved === "open" : window.innerWidth > 700 && window.innerHeight >= 760);
        button.addEventListener("click", function () {
          var open = bar.classList.contains("is-folded");
          set(open);
          try {
            sessionStorage.setItem(key, open ? "open" : "folded");
          } catch (e) {}
        });
      })();
    </script>

    {
      hasCv && (
        <dialog class="cv-dialog" id="cv-dialog" aria-labelledby="cv-title">
          <div class="cv-bar">
            <h2 id="cv-title">CV</h2>
            <a class="cv-download" href={CV_PATH} download="Salvador-Ferreira-CV.pdf">Download PDF</a>
            <button type="button" class="cv-close" id="cv-close">Close</button>
          </div>
          <div class="cv-page">
            <img src={CV_IMAGE} alt={`CV of ${SITE_NAME}`} width="1405" height="1988" loading="lazy" />
          </div>
        </dialog>
      )
    }
    <script is:inline>
      // The CV opens in a window over the city (without JavaScript the links open the PDF).
      (function () {
        var dialog = document.getElementById("cv-dialog");
        if (!dialog || !dialog.showModal) return;
        document.addEventListener("click", function (event) {
          var link = event.target.closest && event.target.closest(".cv-open");
          if (!link) return;
          event.preventDefault();
          dialog.showModal();
        });
        document.getElementById("cv-close").addEventListener("click", function () {
          dialog.close();
        });
        // A click on the dimmed backdrop closes it too.
        dialog.addEventListener("click", function (event) {
          if (event.target === dialog) dialog.close();
        });
      })();
    </script>

    <p class="toast" id="toast" role="status" aria-live="polite" hidden></p>
    <script is:inline>
      // "Email" copies the address and says so; without the clipboard it shows the address instead.
      (function () {
        var toast = document.getElementById("toast");
        var timer;
        function say(text) {
          toast.textContent = text;
          toast.hidden = false;
          clearTimeout(timer);
          timer = setTimeout(function () {
            toast.hidden = true;
          }, 3200);
        }
        function fallback(email) {
          var field = document.createElement("textarea");
          field.value = email;
          field.setAttribute("readonly", "");
          field.style.position = "fixed";
          field.style.opacity = "0";
          document.body.appendChild(field);
          field.select();
          var ok = false;
          try {
            ok = document.execCommand("copy");
          } catch (e) {}
          field.remove();
          say(ok ? "Email copied: " + email : "Email: " + email);
        }
        document.addEventListener("click", function (event) {
          var button = event.target.closest && event.target.closest(".copy-email");
          if (!button) return;
          var email = button.getAttribute("data-email");
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(email).then(
              function () {
                say("Email copied: " + email);
              },
              function () {
                fallback(email);
              },
            );
          } else fallback(email);
        });
      })();
    </script>

    <noscript>
      <div class="fallback">
        <img src="/city.jpg" alt="Lisbon seen from above" />
        <a class="fallback-text" href="/profile">Everything on this site as text</a>
      </div>
    </noscript>

    <script is:inline>
      (function () {
        var el = document.getElementById("lisbon-time");
        var format = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Lisbon", hour: "2-digit", minute: "2-digit" });
        function tick() {
          // The 3D city replaces this clock with its own (Daylight.tsx).
          if (document.contains(el)) el.textContent = format.format(new Date());
        }
        tick();
        setInterval(tick, 15000);
      })();
    </script>
  </body>
</html>
