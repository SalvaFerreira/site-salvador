---
import { existsSync } from "node:fs";
import Analytics from "@vercel/analytics/astro";
import { SITE_NAME } from "../lib/places";

interface Props {
  title?: string;
  /** The whole title, for the home page (otherwise "<title> — <name>"). */
  fullTitle?: string;
  description: string;
  /** Name of the preview image in public/og/, without extension. */
  image?: string;
  /** schema.org data about the page, written as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, jsonLd } = Astro.props;
const fullTitle = Astro.props.fullTitle ?? (title ? `${title} — ${SITE_NAME}` : SITE_NAME);
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const preview = image && existsSync(`./public/og/${image}.jpg`) ? image : "home";
const imageUrl = new URL(`/og/${preview}.jpg`, base);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Salvador's photo, round (made from eu.png). -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<Analytics />
