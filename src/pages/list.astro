---
// Everything on the site as plain text, in reading order.
import Head from "../components/Head.astro";
import { CV_PATH, getAbout, getPerson, getPlaces, hasCv, htmlOf, pathOf, PORTRAIT, SITE_NAME } from "../lib/places";
import "../styles/global.css";

const places = await getPlaces();
const about = await getAbout();
const person = await getPerson(Astro.site);
const sections = places.map((entry) => ({ entry, html: htmlOf(entry.rendered) }));
---

<!doctype html>
<html lang="en">
  <head>
    <Head title="List" description={`Everything on the website of ${SITE_NAME}, as plain text.`} jsonLd={person} />
  </head>
  <body class="list-page">
    <main>
      <header>
        <div class="list-head">
          <img class="portrait" src={PORTRAIT} alt={`Photo of ${SITE_NAME}`} width="72" height="72" />
          <h1>{SITE_NAME}</h1>
        </div>
        <div class="list-about" set:html={about.html} />
        <p class="list-links">
          <a href="/">City</a>
          {hasCv && <a href={CV_PATH}>CV (PDF)</a>}
        </p>
      </header>

      {
        sections.map(({ entry, html }) => (
          <section id={entry.id}>
            <p class="list-place">{entry.data.place}</p>
            <h2>
              <a href={pathOf(entry)}>{entry.data.title}</a>
            </h2>
            {(entry.data.role || entry.data.period) && (
              <p class="list-role">{[entry.data.role, entry.data.period].filter(Boolean).join(" · ")}</p>
            )}
            {entry.data.stack.length > 0 && <p class="list-place">{entry.data.stack.join(" · ")}</p>}
            <Fragment set:html={html} />
            {entry.data.images.map((image) => (
              image.src.endsWith(".mp4") ? (
                <video class="list-image" src={image.src} poster={image.poster} aria-label={image.alt} muted loop playsinline controls preload="none" />
              ) : (
                <img class="list-image" src={image.src} alt={image.alt} loading="lazy" />
              )
            ))}
            {entry.data.links.length > 0 && (
              <p class="list-links">
                {entry.data.links.map((link) => (
                  <a href={link.url}>{link.label}</a>
                ))}
              </p>
            )}
          </section>
        ))
      }

      <footer>
        <p>
          Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a> · Green spaces, trees and
          railways: Câmara Municipal de Lisboa · Elevation: Copernicus DEM GLO-30, © DLR e.V. 2010-2014 and © Airbus Defence and
          Space GmbH 2014-2018, provided under COPERNICUS by the European Union and ESA
        </p>
      </footer>
    </main>
  </body>
</html>
